# --- Database (SQLite file, created automatically). For Vercel use a hosted libSQL/Turso URL + token. ---
DATABASE_URL=file:./data/qaforge.db
DATABASE_AUTH_TOKEN=

# --- Secrets encryption (Jira API token). 32+ random chars. ---
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ENCRYPTION_SECRET=

# --- AI (Groq). Server-side only; never shown in the UI. ---
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Used automatically when the main model's daily quota runs out
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b

# --- Optional: email bug assignments via Resend. Without it, a mailto: draft opens. ---
RESEND_API_KEY=
MAIL_FROM="TestForge AI <onboarding@resend.dev>"
